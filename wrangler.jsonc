{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floral-wood-c42bbaa1118-gemini-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-10-26",
  "vars": {
    "ALLOWED_ORIGIN": "https://cassidyjames011-coder.github.io",
    "APPROVED_MODELS": "gemini-3.5-flash-lite",
    "PRIVACY_REVIEW_APPROVED": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DAILY_QUOTA",
        "class_name": "DailyQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DailyQuota"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
