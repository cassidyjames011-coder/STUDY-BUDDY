{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"studioza-ai-staging",
  "main":"worker.js",
  "compatibility_date":"2026-10-26",
  "vars":{"ALLOWED_ORIGIN":"https://studioza-staging.cassidyjames011.workers.dev","APPROVED_MODELS":"gemini-3.5-flash-lite","APP_ENV":"staging","MOCK_AI":"true","TURNSTILE_SECRET_KEY":"1x0000000000000000000000000000000AA"},
  "durable_objects":{"bindings":[{"name":"DAILY_QUOTA","class_name":"DailyQuota"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["DailyQuota"]}],
  "ratelimits":[{"name":"RATE_LIMITER","namespace_id":"1002","simple":{"limit":10,"period":60}}],
  "observability":{"enabled":true,"head_sampling_rate":1,"logs":{"enabled":true,"invocation_logs":false}}
}
